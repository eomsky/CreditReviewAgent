APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Colab vLLM OpenAI-compatible API
COLAB_LLM_BASE_URL=https://xxxx.ngrok-free.app/v1
COLAB_LLM_MODEL=credit-review-qwen-vl-32b
COLAB_LLM_API_KEY=change-me
COLAB_LLM_TIMEOUT_SECONDS=300

# Persistent paths under the repository (/workspaces/... in Codespaces)
DATABASE_URL=sqlite+aiosqlite:///./data/database/credit_review.db
CHROMA_PERSIST_DIR=./data/vector_db/chroma
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
BACKUP_DIR=./data/backups

# RAG
CHROMA_COLLECTION=credit_documents
EMBEDDING_MODEL=BAAI/bge-m3
RAG_TOP_K=5

